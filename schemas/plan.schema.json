{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openshift-storage-cert/storage-cert-harness/schemas/plan.schema.json",
  "title": "Test Plan",
  "description": "A curated, parameterized selection of catalog test requirements plus run settings, per-tool scheduling, and the active backend. Authored in YAML; this schema describes the parsed structure. See decisions/0005 and 0006.",
  "type": "object",
  "required": ["schema_version", "name", "select"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "backend": { "type": "string", "description": "name of the active backend (optional)" },
    "scenario": { "type": "string", "description": "run label stamped onto every verdict (e.g. under-pressure); distinguishes merged runs of the same TR" },
    "concurrency": { "type": "integer", "minimum": 0 },
    "select": { "$ref": "#/$defs/selector" },
    "report_metrics": {
      "type": "object",
      "description": "TR id -> extra report metric selectors (name or name@percentile); missing values warn only",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "overrides": {
      "type": "object",
      "description": "TR id -> tool param overrides merged onto the selected TR",
      "additionalProperties": { "type": "object" }
    },
    "variants": {
      "type": "object",
      "description": "TR id -> named executions replacing the default run; params override plan overrides",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
            "params": { "type": "object" }
          }
        }
      }
    },
    "scheduling": {
      "type": "object",
      "description": "tool name -> per-run override of the tool's built-in scheduling defaults",
      "additionalProperties": { "$ref": "#/$defs/tool_schedule" }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "boolean" },
        "ids": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "partner_levels": { "type": "array", "items": { "type": "integer", "enum": [1, 2, 3] } }
      },
      "anyOf": [
        { "properties": { "all": { "const": true } }, "required": ["all"] },
        { "required": ["ids"] },
        { "required": ["tools"] },
        { "required": ["partner_levels"] }
      ]
    },
    "tool_schedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel_safe": { "type": "boolean" },
        "exclusivity_groups": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
